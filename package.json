{
  "name": "smartwardrobe",
  "version": "0.1.0",
  "private": true,
  "description": "SmartWardrobe — gestor inteligente de armario y asistente personal de estilo (PMV estático, datos locales en el navegador).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/e2e.mjs",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
